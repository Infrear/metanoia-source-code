-- SlotSummarySync.server.lua
-- Additive, standalone script. Does NOT modify DataManager.lua.
--
-- DataManager.lua's GetProfileData / SelectSlot remotes already read & write
-- a per-player ProfileStore entry shaped like:
--   { Slots = { ["1"] = {Created, Playtime, Level}, ... }, LastPlayedSlot = "1" }
--
-- This script mirrors a few extra live stats into that SAME entry, under the
-- SAME key, so the Slot Select screen can show real numbers for a slot
-- before it's ever loaded again:
--   - Euros / Persona count  (pushed whenever they change)
--   - Aura                   (defaulted once, never overwritten -- see below)
--   - Playtime                (accrued every FLUSH_INTERVAL seconds, plus a
--                              final flush the moment the player leaves)
--
-- "Aura" (the player's overall rarity/class) isn't generated by any system
-- yet -- it's still a roadmap item. Until the real gacha/aura system exists,
-- new slots default to "Dormant" and this script will NEVER overwrite an
-- Aura value that's already been set (by this script or a future one), so
-- wiring in the real system later is just: write slot.Aura yourself and this
-- script will leave it alone from that point on.

local PLRS = game:GetService("Players")
local SS = game:GetService("ServerStorage")
local DSS = game:GetService("DataStoreService")

local odm = require(SS:WaitForChild("Storage"):WaitForChild("Classes"):WaitForChild("StaticClasses"):WaitForChild("Obi's DS Manager"))
local ProfileStore = DSS:GetDataStore("PlayerProfiles1.69.93") -- same store as DataManager.lua

local DEFAULT_AURA = "Dormant"
local FLUSH_INTERVAL = 30 -- seconds between periodic playtime accrual / DataStore writes

local writeCooldown = {}     -- [plr] = true while a throttled write is pending/cooling down
local sessionLastFlush = {}  -- [plr] = os.clock() at last playtime flush

local function writeSummary(plr, slotId, euros, personas, playtimeDelta)
	if writeCooldown[plr] then return end
	writeCooldown[plr] = true

	task.spawn(function()
		local ok, err = pcall(function()
			ProfileStore:UpdateAsync("Profile_" .. plr.UserId, function(oldProfile)
				local prof = oldProfile or { Slots = {} }
				prof.Slots = prof.Slots or {}

				local slot = prof.Slots[slotId] or { Created = true, Playtime = 0, Level = 1 }
				slot.Created = true
				slot.Euros = euros
				slot.Personas = personas
				slot.Aura = slot.Aura or DEFAULT_AURA -- never clobber a real aura once one is set
				slot.Playtime = (slot.Playtime or 0) + (playtimeDelta or 0)

				prof.Slots[slotId] = slot
				return prof
			end)
		end)

		if not ok then
			warn("[SlotSummarySync] Failed updating profile for " .. plr.Name .. ": " .. tostring(err))
		end

		task.wait(6) -- throttle: DataStore budget friendly
		writeCooldown[plr] = nil
	end)
end

-- Returns seconds elapsed since this player's last flush, and resets the clock.
local function takeElapsed(plr)
	local now = os.clock()
	local last = sessionLastFlush[plr] or now
	sessionLastFlush[plr] = now
	return math.max(0, math.floor(now - last))
end

local function hookPlayer(plr)
	task.spawn(function()
		while plr.Parent do
			local entry = odm.PlayerData[plr]
			if entry and entry.Data then
				local data = entry.Data
				local slotId = data.SlotId or "1"
				sessionLastFlush[plr] = os.clock()

				local function push(extraPlaytime)
					local euros = data.Euros and data.Euros.Data or 0
					local personas = (data.PersonaStock and data.PersonaStock.Data and data.PersonaStock.Data.Stock)
						and #data.PersonaStock.Data.Stock or 0
					writeSummary(plr, slotId, euros, personas, extraPlaytime or 0)
				end

				push() -- initial snapshot right after slot load, no playtime yet

				if data.Euros then
					data.Euros.Changed.Event:Connect(function() push() end)
				end
				if data.PersonaStock then
					data.PersonaStock.Changed.Event:Connect(function() push() end)
				end

				-- Periodic playtime accrual while this slot stays active
				task.spawn(function()
					while plr.Parent and odm.PlayerData[plr] and odm.PlayerData[plr].Data == data do
						task.wait(FLUSH_INTERVAL)
						if not (plr.Parent and odm.PlayerData[plr] and odm.PlayerData[plr].Data == data) then
							break
						end
						local elapsed = takeElapsed(plr)
						if elapsed > 0 then
							push(elapsed)
						end
					end
				end)

				break
			end
			task.wait(1)
		end
	end)
end

PLRS.PlayerAdded:Connect(hookPlayer)
for _, plr in ipairs(PLRS:GetPlayers()) do
	hookPlayer(plr)
end

-- Guaranteed final flush the moment a player leaves, so the last few
-- seconds/minutes of a session are never lost.
PLRS.PlayerRemoving:Connect(function(plr)
	local entry = odm.PlayerData[plr]
	if entry and entry.Data then
		local data = entry.Data
		local slotId = data.SlotId or "1"
		local elapsed = takeElapsed(plr)

		if elapsed > 0 then
			local euros = data.Euros and data.Euros.Data or 0
			local personas = (data.PersonaStock and data.PersonaStock.Data and data.PersonaStock.Data.Stock)
				and #data.PersonaStock.Data.Stock or 0

			pcall(function()
				ProfileStore:UpdateAsync("Profile_" .. plr.UserId, function(oldProfile)
					local prof = oldProfile or { Slots = {} }
					prof.Slots = prof.Slots or {}

					local slot = prof.Slots[slotId] or { Created = true, Playtime = 0, Level = 1 }
					slot.Created = true
					slot.Euros = euros
					slot.Personas = personas
					slot.Aura = slot.Aura or DEFAULT_AURA
					slot.Playtime = (slot.Playtime or 0) + elapsed

					prof.Slots[slotId] = slot
					return prof
				end)
			end)
		end
	end

	sessionLastFlush[plr] = nil
	writeCooldown[plr] = nil
end)
